HTTP_PORT=8080
APP_BASE_URL=http://localhost:8080
DEFAULT_LANGUAGE=de
LOG_LEVEL=info
POSTGRES_DB=zentwhook
POSTGRES_USER=zentwhook
POSTGRES_PASSWORD=change-me-now
EVENT_RETENTION_DAYS=30
SUCCESS_RETENTION_DAYS=14
FAILED_RETENTION_DAYS=90
ALLOW_PRIVATE_DESTINATIONS=false
ALLOW_LOCALHOST_DESTINATIONS=false
# Optional: first admin can be created automatically. Leave blank for web setup.
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional machine-to-machine API token. Session login works without it.
API_TOKEN=
